# Copy to .env.local and fill in. Everything here is public (bundled into the browser): no secrets.
# Read only in src/infrastructure/config.ts; values are frozen at build time.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_QUEUE_API_URL=http://localhost:8081/v1
NEXT_PUBLIC_CORE_API_URL=http://localhost:8082/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_DEFAULT_LOCALE=id
# true = answer API calls with MSW sample data (src/infrastructure/mocks). Local dev and previews only, never production.
NEXT_PUBLIC_API_MOCK=false

# Sentry (NFR-09-W1). The DSN is public by design; leave it empty to turn Sentry off. Sample rates are 0–1.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_RATE=1

# Send X-Request-ID on API calls (NFR-09-W1). Keep false until the API's CORS allows the header (queue does not yet).
NEXT_PUBLIC_REQUEST_ID_HEADER=false

# Product analytics (NFR-09-W2): true shows the cookie consent banner and settings (and later loads GA4 after a yes).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# GA4 web stream measurement ID (Firebase project rusuh-app, public). Used only with the flag above and after a yes.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
